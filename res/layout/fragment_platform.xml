<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Platform Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:marginBottom="16dp">

            <ImageView
                android:id="@+id/platformIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerInside"
                android:contentDescription="Platform icon" />

            <TextView
                android:id="@+id/platformName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:marginStart="16dp" />
        </LinearLayout>

        <!-- Link Input Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Video/Post Link"
            android:textSize="16sp"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:marginBottom="8dp" />

        <EditText
            android:id="@+id/linkInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Paste link here..."
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:background="@drawable/edit_text_background"
            android:paddingHorizontal="12dp" />

        <TextView
            android:id="@+id/linkDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No link added"
            android:textSize="14sp"
            android:textColor="#888888"
            android:marginTop="8dp"
            android:marginBottom="16dp" />

        <!-- Link Management Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="8dp"
            android:marginBottom="24dp">

            <Button
                android:id="@+id/btnAddLink"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Add"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1F7F1F"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Clear"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7F1F1F"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnSaveLink"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1F4F7F"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Views Input Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target Views"
            android:textSize="16sp"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:marginBottom="8dp" />

        <EditText
            android:id="@+id/inputViews"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter number of views"
            android:inputType="number"
            android:text="100"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:background="@drawable/edit_text_background"
            android:paddingHorizontal="12dp"
            android:marginBottom="16dp" />

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="8dp"
            android:marginBottom="24dp">

            <Button
                android:id="@+id/btnStartViewing"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#FF0000"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/btnStopViewing"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#666666"
                android:enabled="false"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>

        <!-- Stats Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Statistics"
            android:textSize="16sp"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1F1F1F"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Views:"
                        android:textSize="14sp"
                        android:textColor="#CCCCCC" />

                    <TextView
                        android:id="@+id/statsViews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="14sp"
                        android:textColor="#00FF00"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Success:"
                        android:textSize="14sp"
                        android:textColor="#CCCCCC" />

                    <TextView
                        android:id="@+id/statsSuccessRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0%"
                        android:textSize="14sp"
                        android:textColor="#00FF00"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Runtime:"
                        android:textSize="14sp"
                        android:textColor="#CCCCCC" />

                    <TextView
                        android:id="@+id/statsRuntime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0s"
                        android:textSize="14sp"
                        android:textColor="#00FF00"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Speed:"
                        android:textSize="14sp"
                        android:textColor="#CCCCCC" />

                    <TextView
                        android:id="@+id/statsSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 v/s"
                        android:textSize="14sp"
                        android:textColor="#00FF00"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
